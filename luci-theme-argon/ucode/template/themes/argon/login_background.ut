{# Background selection and rendering. cfg is the caller's UCI cursor. -#}
{%
	import * as fs from 'fs';

	// Per-request pseudo-random state for selecting local backgrounds.
	let lcgState = (+time()) % 2147483648;

	function randomIndex(limit) {
		lcgState = (lcgState * 1103515245 + 12345) % 2147483648;

		return lcgState % limit;
	}

	//Fetch Local Background Media

	const imageTypes = " jpg jpeg png gif webp ";
	const videoTypes = " mp4 webm ";
	const allTypes = imageTypes + videoTypes;

	function fetchMedia(path, themeDir) {
		let backgroundTable = [];
		for (f in (fs.lsdir(path))) {
			let parts = split(f, '.');
			let ext = lc(parts?.[length(parts) - 1]);
			if (ext && index(allTypes, " " + ext + " ") != -1) {
				let bg = {};
				bg.type = ext;
				bg.url = themeDir + http.urlencode(f);
				push(backgroundTable, bg);
			}
		}
		return backgroundTable;
	}

	function selectBackground(themeDir) {
		let bgUrl = media + "/img/bg1.webp";
		let backgroundType = "Image";
		let mimeType = "";

		if (fs.access("/etc/config/argon")) {
			let online_wallpaper = cfg.get_first('argon', 'global', 'online_wallpaper') ?? (cfg.get_first('argon', 'global', 'bing_background') == '1' ? 'bing' : null);
			if (online_wallpaper && online_wallpaper != "none") {
				const picurl = ubus.call("luci.argon_wallpaper", "get_url") ?? {};
				if (type(picurl?.url) == 'string' && match(picurl.url, /^https:\/\/[^[:space:]"'<>]+$/)) {
					bgUrl = picurl.url;
					return {bgUrl, backgroundType, mimeType};
				}
			}
		}

		let background = fetchMedia("/www" + themeDir, themeDir);
		if ( length(background) > 0 ) {
			let currentBg = background[randomIndex(length(background))];
			bgUrl = currentBg.url;
			if (index(videoTypes, " " + currentBg.type + " ") != -1) {
				backgroundType = "Video";
				mimeType = "video/" + currentBg.type;
			}
		}

		return {bgUrl, backgroundType, mimeType};
	}

	const bgArry = selectBackground(media + '/background/');
%}
	{% if ( bgArry.backgroundType == "Video" ): %}
	<!-- Video Player Start -->
	<div class="video">
		<video loop muted playsinline id="video" poster="{{ media }}/img/bg1.webp">
			<source src="{{ entityencode(bgArry.bgUrl, true) }}" type="{{ bgArry.mimeType }}">
		</video>
	</div>
	<button type="button" class="volume-control mute" aria-label="{{ entityencode(_('Mute background video'), true) }}" aria-pressed="true"></button>
	<script>
		var backgroundVideo = document.getElementById("video");
		var motionPreference = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
		function updateBackgroundMotion() {
			if (motionPreference && motionPreference.matches)
				backgroundVideo.pause();
			else {
				var playResult = backgroundVideo.play();
				if (playResult && playResult.catch)
					playResult.catch(function() {});
			}
		}
		updateBackgroundMotion();
		if (motionPreference) {
			if (motionPreference.addEventListener)
				motionPreference.addEventListener('change', updateBackgroundMotion);
			else if (motionPreference.addListener)
				motionPreference.addListener(updateBackgroundMotion);
		}
		document.querySelector(".volume-control").addEventListener("click", function(){
			if(this.classList.contains("mute")){
				this.classList.remove("mute");
				backgroundVideo.muted = false;
				this.setAttribute('aria-pressed', 'false');
			}else{
				this.classList.add("mute");
				backgroundVideo.muted = true;
				this.setAttribute('aria-pressed', 'true');
			}
		});
	</script>
	<!-- Video Player End -->
	{% else %}
	<!-- Image Background Start -->
	<div class="main-bg" id="main-bg"><img src="{{ entityencode(bgArry.bgUrl, true) }}" data-fallback="{{ media }}/img/bg1.webp" onerror="this.onerror=null;this.src=this.dataset.fallback" alt=""></div>
	<!-- Image Background End -->
	{% endif %}
