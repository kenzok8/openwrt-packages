{#
	Argon is a clean HTML5 theme for LuCI. It is based on luci-theme-material Argon Template

	luci-theme-argon
	Copyright 2020 Jerrykuku <jerrykuku@qq.com>

	Have a bug? Please create an issue here on GitHub!
	https://github.com/jerrykuku/luci-theme-argon/issues

	luci-theme-material:
	Copyright 2015 Lutty Yang <lutty@wcan.in>

	Agron Theme
	https://demos.creative-tim.com/argon-dashboard/index.html

	Licensed to the public under the Apache License 2.0
-#}

</div>
{%
	const luci_info = 'Powered by ' + version.luciname + ' (' + version.luciversion + ')';
	const firmware_info = version.distname + ' ' + version.distversion + '-' + version.distrevision;
%}
<footer>
	<div title="{{ entityencode(luci_info + ' · ArgonTheme · ' + firmware_info, true) }}">
		<a class="luci-link" href="https://github.com/openwrt/luci" target="_blank" title="{{ entityencode(luci_info, true) }}"><span class="login-footer-detail">Powered by </span>{{ version.luciname }}<span class="login-footer-detail"> ({{ version.luciversion }})</span></a>
		<a href="https://github.com/jerrykuku/luci-theme-argon" target="_blank">ArgonTheme {# vPKG_VERSION #}</a>
		<a class="luci-link" href="{{ version.disturl }}" target="_blank" title="{{ entityencode(firmware_info, true) }}">{{ version.distname }} {{ version.distversion }}<span class="login-footer-detail">-{{ version.distrevision }}</span></a>
	</div>
</footer>
</div>
</div>
	<script>
		// thanks for Jo-Philipp Wich <jow@openwrt.org>
		var luciLocation = {{ ctx.path }};
	</script>
</body>
</html>
