{# Complete authentication form; auth_* values come from the dispatcher scope. -#}
<form class="form-login" method="post" action="{{ entityencode(http.getenv("REQUEST_URI"), true) }}">

	{#-
	 `auth_plugin` is set only on the render that follows an ACCEPTED password
	 (dispatcher.uc), so it is what separates "the password was wrong" from "the
	 password was right and a plugin wants more". Gating the credentials alert on
	 `!auth_plugin` and showing `auth_message` beside it rather than instead of it
	 covers all four states: a wrong password, a wrong password with a challenge
	 already pending, the challenge prompt itself, and a failed challenge.
	-#}
	{%- if (fuser && !auth_plugin): %}
	<div class="errorbox">{{ _('Invalid username and/or password! Please try again.') }}</div>
	{% endif -%}

	{%- if (auth_message): %}
	<div class="errorbox">{{ auth_message }}</div>
	{% endif -%}

	<div class="input-container">
		<div class="input-group user-icon">
			<label class="visually-hidden" for="cbi-input-user">{{ _('Username') }}</label>
			<input class="cbi-input-user" id="cbi-input-user" type="text" name="luci_username" autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="{{ entityencode(_('Username'), true) }}" value="{{ entityencode(duser, true) }}" />
			<span class="border" aria-hidden="true"></span>
		</div>
		<div class="input-group pass-icon">
			<label class="visually-hidden" for="cbi-input-password">{{ _('Password') }}</label>
			<input class="cbi-input-password" id="cbi-input-password" type="password" name="luci_password" autocomplete="current-password" placeholder="{{ entityencode(_('Password'), true) }}" />
			<span class="border" aria-hidden="true"></span>
		</div>
		{%- if (auth_fields): %}
		{%- for (let field in auth_fields): %}
		{#- Keep a plugin's format hint as the placeholder, while its label or
		 field name provides an accessible name for the input. -#}
			<div class="input-group pass-icon">
				<label class="visually-hidden" for="{{ entityencode(field.name, true) }}">{{ entityencode(_(field.label || field.name)) }}</label>
				<input class="cbi-input-text" id="{{ entityencode(field.name, true) }}" type="{{ entityencode(field.type ?? 'text', true) }}" name="{{ entityencode(field.name, true) }}"
					placeholder="{{ entityencode(_(field.label ?? field.placeholder ?? field.name), true) }}"
					{% if (field.placeholder): %}title="{{ entityencode(field.placeholder, true) }}"{% endif %}
					{% if (field.inputmode): %}inputmode="{{ entityencode(field.inputmode, true) }}"{% endif %}
					{% if (field.pattern): %}pattern="{{ entityencode(field.pattern, true) }}"{% endif %}
					{% if (field.maxlength): %}maxlength="{{ entityencode('' + field.maxlength, true) }}"{% endif %}
					{% if (field.autocomplete): %}autocomplete="{{ entityencode(field.autocomplete, true) }}"{% endif %}
					{% if (field.required): %}required{% endif %} />
				<span class="border" aria-hidden="true"></span>
		</div>
		{%- endfor %}
		{%- endif %}
	</div>
	{%- if (auth_html): %}
	<div class="auth-plugin">{{ auth_html }}</div>
	{% endif -%}

	<div>
		<input type="submit" value="{{ _('Log in') }}" class="cbi-button cbi-button-apply" />
	</div>
	{#- Loaded last so the markup a plugin emitted through `auth_html` is already
	 in the document when its script runs. -#}
	{%- if (auth_assets): %}
	{%- for (let asset in auth_assets): %}
	{%- if (asset.type == 'script'): %}
	<script src="{{ asset.src }}"></script>
	{%- endif %}
	{%- endfor %}
	{%- endif %}
</form>
<!-- Login Form End -->
<script type="text/javascript">//<![CDATA[
	var input = document.getElementsByName('luci_password')[0];
	if (input)
		input.focus();
//]]></script>
