#!/bin/sh
echo "apk $*" >> "$STATE/log"
args=''; skip=0
for a in "$@"; do
	if [ "$skip" = 1 ]; then skip=0; continue; fi
	case "$a" in --keys-dir|--repositories-file) skip=1 ;; -*) ;; *) args="$args $a" ;; esac
done
set -- $args
cmd=$1; shift
case "$cmd" in
	verify) exit "${APK_VERIFY_RC:-0}" ;;
	list) [ -f "$STATE/pkgs/$1" ] && echo "$1-$(cat "$STATE/pkgs/$1") noarch {$1} (MIT) [installed]"; exit 0 ;;
	version) if [ "$1" = "$2" ]; then echo '='; elif [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" = "$1" ]; then echo '<'; else echo '>'; fi ;;
	update) exit 0 ;;
	add)
		for a in "$@"; do
			case "$a" in
				*.apk) [ "${APK_ADD_RC:-0}" = 0 ] || exit 1; cat "$(dirname "$a")/apk.version" > "$STATE/pkgs/luci-theme-carbon" ;;
				*) [ -z "$DEPS_FAIL" ] || exit 1; echo 1.0-r1 > "$STATE/pkgs/$a" ;;
			esac
		done ;;
	del) rm -f "$STATE/pkgs/$1" ;;
esac
