#!/bin/sh
echo "opkg $*" >> "$STATE/log"
cmd=$1; shift
case "$cmd" in
	status) [ -f "$STATE/pkgs/$1" ] && printf 'Package: %s\nVersion: %s\nStatus: install user installed\n' "$1" "$(cat "$STATE/pkgs/$1")"; exit 0 ;;
	compare-versions)
		if [ "$1" = "$3" ]; then r='='; elif [ "$(printf '%s\n%s\n' "$1" "$3" | sort -V | head -n 1)" = "$1" ]; then r='<'; else r='>'; fi
		case "$2" in '<<') [ "$r" = '<' ] ;; '=') [ "$r" = '=' ] ;; *) exit 2 ;; esac ;;
	update) exit 0 ;;
	install)
		for a in "$@"; do
			case "$a" in
				--*) ;;
				*.ipk) cat "$(dirname "$a")/opkg.version" > "$STATE/pkgs/luci-theme-carbon" ;;
				*) [ -z "$DEPS_FAIL" ] || exit 1; echo 1.0-1 > "$STATE/pkgs/$a" ;;
			esac
		done ;;
	remove) rm -f "$STATE/pkgs/$1" ;;
esac
