{
	"luci-theme-carbon": {
		"description": "Carbon theme: read-only dashboard data and the interface language switch",
		"read": {
			"ubus": {
				"system": [ "board", "info" ],
				"network.interface": [ "dump" ],
				"network.device": [ "status" ],
				"network.wireless": [ "status" ],
				"iwinfo": [ "assoclist" ],
				"luci-rpc": [ "getDHCPLeases", "getNetworkDevices", "getHostHints" ],
				"file": [ "list", "read" ],
				"uci": [ "get" ]
			},
			"file": {
				"/proc/stat": [ "read" ],
				"/proc/net/arp": [ "read" ],
				"/proc/sys/net/netfilter/nf_conntrack_count": [ "read" ],
				"/proc/sys/net/netfilter/nf_conntrack_max": [ "read" ],
				"/sys/class/thermal": [ "list" ],
				"/sys/class/thermal/thermal_zone*/temp": [ "read" ],
				"/sys/class/thermal/thermal_zone*/type": [ "read" ],
				"/sys/class/hwmon": [ "list" ],
				"/sys/class/hwmon/hwmon*": [ "list" ],
				"/sys/class/hwmon/hwmon*/name": [ "read" ],
				"/sys/class/hwmon/hwmon*/temp*_input": [ "read" ]
			},
			"uci": [ "luci" ]
		},
		"write": {
			"ubus": {
				"uci": [ "set", "commit" ]
			},
			"uci": [ "luci" ]
		}
	}
}
