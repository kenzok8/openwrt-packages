#!/bin/sh
# luci-app-openclaw — Backend helper for JS view
# Called via ubus file.exec from the LuCI frontend

. /lib/functions.sh 2>/dev/null || true
. /usr/share/openclaw/oc-lib.sh

# JSON 字符串转义：line 把换行折成空格（单行字段），block 把换行写成 \n（日志）
# 逐字符处理，不用 gsub 替换，避免各版 awk 对替换串里的反斜杠解释不一致。
json_escape() {
	awk -v mode="$1" '
		BEGIN { ORS = ""; bs = sprintf("%c", 92); out = "" }
		{
			if (NR > 1) out = out (mode == "block" ? bs "n" : " ")
			line = $0
			for (i = 1; i <= length(line); i++) {
				c = substr(line, i, 1)
				if (c == "\\") out = out bs bs
				else if (c == "\"") out = out bs "\""
				else if (c == "\t") out = out bs "t"
				else if (c == "\r") out = out bs "r"
				else out = out c
			}
		}
		END { printf "%s", out }'
}

json_esc() {
	printf '%s' "$1" | json_escape line
}

# 作业进度：setup 与 plugin_upgrade 共用同一套 /tmp/<prefix>.{log,pid,exit}
# job_state <prefix> — 输出 state/exit_code/log 的 JSON
job_state() {
	local prefix="$1" log="" running=false pid exit_code=-1 state=idle log_escaped
	[ -f "/tmp/${prefix}.log" ] && log=$(cat "/tmp/${prefix}.log" 2>/dev/null)
	if [ -f "/tmp/${prefix}.pid" ]; then
		pid=$(cat "/tmp/${prefix}.pid" 2>/dev/null | tr -d '[:space:]')
		[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && running=true
	fi
	if [ "$running" = "false" ] && [ -f "/tmp/${prefix}.exit" ]; then
		exit_code=$(cat "/tmp/${prefix}.exit" 2>/dev/null | tr -d '[:space:]')
		[ -z "$exit_code" ] && exit_code=-1
	fi
	if [ "$running" = "true" ]; then state="running"
	elif [ "$exit_code" = "0" ]; then state="success"
	elif [ "$exit_code" -gt 0 ] 2>/dev/null; then state="failed"
	fi
	log_escaped=$(printf '%s' "$log" | json_escape block)
	printf '{"state":"%s","exit_code":%s,"log":"%s"}\n' "$state" "$exit_code" "$log_escaped"
}

# ── Port listening check (ss or netstat) ──
port_listening() {
	local p="$1"
	if command -v ss >/dev/null 2>&1; then
		ss -tulnp 2>/dev/null | grep -q ":${p} "
	else
		netstat -tulnp 2>/dev/null | grep -q ":${p} "
	fi
}

pid_by_port() {
	local p="$1"
	if command -v ss >/dev/null 2>&1; then
		ss -tulnp 2>/dev/null | grep ":${p} " | sed -n 's/.*pid=\([0-9]*\).*/\1/p' | head -1
	else
		netstat -tulnp 2>/dev/null | grep ":${p} " | sed -n 's|.* \([0-9]*\)/.*|\1|p' | head -1
	fi
}

df_avail_mb() {
	local path="$1"
	mkdir -p "$path" 2>/dev/null || true
	df -Pk "$path" 2>/dev/null | awk 'NR==2{print int($4/1024)}'
}

mem_total_mb() {
	awk '/MemTotal/{print int($2/1024)}' /proc/meminfo 2>/dev/null
}

swap_total_mb() {
	awk '/SwapTotal/{print int($2/1024)}' /proc/meminfo 2>/dev/null
}

preflight_source_setup() {
	local root_free opt_free mem_mb swap_mb level message
	root_free=$(df_avail_mb /)
	opt_free=$(df_avail_mb /opt/openclaw)
	mem_mb=$(mem_total_mb)
	swap_mb=$(swap_total_mb)
	[ -n "$root_free" ] || root_free=0
	[ -n "$opt_free" ] || opt_free=0
	[ -n "$mem_mb" ] || mem_mb=0
	[ -n "$swap_mb" ] || swap_mb=0

	if [ "$opt_free" -lt 2048 ] 2>/dev/null; then
		message="源码安装需要 /opt/openclaw 所在分区至少 2GB 可用空间，当前约 ${opt_free}MB。建议改用远端 Gateway 模式。"
		printf '{"status":"error","message":"%s","root_free_mb":%s,"opt_free_mb":%s,"mem_total_mb":%s,"swap_total_mb":%s}\n' "$(json_esc "$message")" "$root_free" "$opt_free" "$mem_mb" "$swap_mb"
		return 1
	fi
	if [ "$root_free" -lt 300 ] 2>/dev/null; then
		message="源码安装需要根分区至少 300MB 可用空间，当前约 ${root_free}MB。"
		printf '{"status":"error","message":"%s","root_free_mb":%s,"opt_free_mb":%s,"mem_total_mb":%s,"swap_total_mb":%s}\n' "$(json_esc "$message")" "$root_free" "$opt_free" "$mem_mb" "$swap_mb"
		return 1
	fi
	if [ "$mem_mb" -lt 768 ] && [ "$swap_mb" -lt 1024 ] 2>/dev/null; then
		message="内存不足：源码安装至少需要 768MB 内存或 1GB swap，当前内存约 ${mem_mb}MB、swap 约 ${swap_mb}MB。"
		printf '{"status":"error","message":"%s","root_free_mb":%s,"opt_free_mb":%s,"mem_total_mb":%s,"swap_total_mb":%s}\n' "$(json_esc "$message")" "$root_free" "$opt_free" "$mem_mb" "$swap_mb"
		return 1
	fi

	level="ok"
	message="资源预检通过。源码安装完成后不会自动启用或启动服务。"
	if [ "$mem_mb" -lt 1536 ] || [ "$swap_mb" -lt 2048 ] 2>/dev/null; then
		level="warn"
		message="资源预检通过，但当前内存约 ${mem_mb}MB、swap 约 ${swap_mb}MB，源码运行仍可能吃紧。建议优先使用远端 Gateway 模式。"
	fi
	printf '{"status":"ok","level":"%s","message":"%s","root_free_mb":%s,"opt_free_mb":%s,"mem_total_mb":%s,"swap_total_mb":%s}\n' "$level" "$(json_esc "$message")" "$root_free" "$opt_free" "$mem_mb" "$swap_mb"
}

case "$1" in

# ═══════════════════════════════════════════
# STATUS — gather all status info as JSON
# ═══════════════════════════════════════════
status)
	enabled=$(uci -q get openclaw.main.enabled || echo "0")
	mode=$(uci -q get openclaw.main.mode || echo "remote")
	port=$(uci -q get openclaw.main.port || echo "18789")
	pty_port=$(uci -q get openclaw.main.pty_port || echo "18793")
	remote_url=$(uci -q get openclaw.main.remote_url || echo "")
	remote_token=$(uci -q get openclaw.main.remote_token || echo "")

	# Validate ports
	case "$port" in *[!0-9]*) port="18789" ;; esac
	case "$pty_port" in *[!0-9]*) pty_port="18793" ;; esac
	case "$mode" in remote|source|local) ;; *) mode="remote" ;; esac

	# Gateway check
	gw_running=false
	gw_starting=false
	if [ "$mode" != "remote" ]; then
		port_listening "$port" && gw_running=true
	fi
	if [ "$mode" != "remote" ] && [ "$gw_running" = "false" ] && [ "$enabled" = "1" ]; then
		pgrep -f 'openclaw.*gateway' >/dev/null 2>&1 && gw_starting=true
	fi

	# PTY check
	pty_running=false
	[ "$mode" != "remote" ] && port_listening "$pty_port" && pty_running=true

	# Node.js version
	node_ver=""
	[ -x "$OC_NODE" ] && node_ver=$("$OC_NODE" --version 2>/dev/null | tr -d '[:space:]')

	# OpenClaw version (from package.json)
	oc_ver=""
	for d in "$OC_GLOBAL/lib/node_modules/openclaw" \
	         "$OC_GLOBAL/node_modules/openclaw" \
	         "/opt/openclaw/node/lib/node_modules/openclaw"; do
		[ -f "$d/package.json" ] || continue
		oc_ver=$(sed -n 's/.*"version" *: *"\([^"]*\)".*/\1/p' "$d/package.json" | head -1)
		[ -n "$oc_ver" ] && break
	done
	# Also check pnpm versioned dirs
	if [ -z "$oc_ver" ]; then
		for d in "$OC_GLOBAL"/*/node_modules/openclaw; do
			[ -f "$d/package.json" ] || continue
			oc_ver=$(sed -n 's/.*"version" *: *"\([^"]*\)".*/\1/p' "$d/package.json" | head -1)
			[ -n "$oc_ver" ] && break
		done
	fi

	# Plugin version
	plugin_ver=""
	[ -f "/usr/share/openclaw/VERSION" ] && plugin_ver=$(cat /usr/share/openclaw/VERSION 2>/dev/null | tr -d '[:space:]')

	# PID, memory, uptime
	pid="" mem_kb=0 uptime_str=""
	if [ "$gw_running" = "true" ]; then
		pid=$(pid_by_port "$port")
		if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
			mem_kb=$(awk '/VmRSS/{print $2}' "/proc/$pid/status" 2>/dev/null)
			[ -z "$mem_kb" ] && mem_kb=0
			# BusyBox 无 stat，用 date -r 读 /proc/$pid 目录 mtime
			start_ts=$(date -r "/proc/$pid" +%s 2>/dev/null)
			if [ -n "$start_ts" ]; then
				now=$(date +%s)
				diff=$((now - start_ts))
				h=$((diff / 3600)) m=$(((diff % 3600) / 60)) s=$((diff % 60))
				if [ $h -gt 0 ]; then uptime_str="${h}h ${m}m"
				elif [ $m -gt 0 ]; then uptime_str="${m}m ${s}s"
				else uptime_str="${s}s"; fi
			fi
		fi
	fi

	# Active model & channels (via Node.js if available)
	active_model="" channels=""
	if [ -f "$OC_CONFIG" ] && [ -x "$OC_NODE" ]; then
		active_model=$("$OC_NODE" -e "
try{const d=JSON.parse(require('fs').readFileSync('$OC_CONFIG','utf8'));
if(d.models&&d.models.primary)process.stdout.write(d.models.primary);}catch(e){}" 2>/dev/null)
		channels=$("$OC_NODE" -e "
try{const d=JSON.parse(require('fs').readFileSync('$OC_CONFIG','utf8'));const c=[];
if(d.qqbot||d.plugins&&d.plugins.entries&&d.plugins.entries['@tencent-connect/openclaw-qqbot'])c.push('QQ');
if(d.telegram&&d.telegram.botToken)c.push('Telegram');
if(d.discord)c.push('Discord');if(d.feishu)c.push('Feishu');if(d.slack)c.push('Slack');
process.stdout.write(c.join(', '));}catch(e){}" 2>/dev/null)
	fi

	cat <<JSON
{
	"enabled": "$enabled",
	"mode": "$mode",
	"port": "$port",
	"pty_port": "$pty_port",
	"remote_url": "$(json_esc "$remote_url")",
	"remote_configured": $([ -n "$remote_url" ] && echo true || echo false),
	"remote_token_set": $([ -n "$remote_token" ] && echo true || echo false),
	"gateway_running": $gw_running,
	"gateway_starting": $gw_starting,
	"pty_running": $pty_running,
	"node_version": "$node_ver",
	"oc_version": "$oc_ver",
	"plugin_version": "$plugin_ver",
	"pid": "$pid",
	"memory_kb": ${mem_kb:-0},
	"uptime": "$uptime_str",
	"active_model": "$(json_esc "$active_model")",
	"channels": "$(json_esc "$channels")"
}
JSON
	;;

# ═══════════════════════════════════════════
# PREFLIGHT_SETUP — validate source install resources
# ═══════════════════════════════════════════
preflight_setup)
	preflight_source_setup
	;;

# ═══════════════════════════════════════════
# SETUP — install Node.js + OpenClaw
# ═══════════════════════════════════════════
setup)
	version="${2:-stable}"
	preflight_source_setup >/tmp/openclaw-setup-preflight.json || {
		cat /tmp/openclaw-setup-preflight.json 2>/dev/null
		exit 1
	}
	# Clean old state
	: > /tmp/openclaw-setup.log
	: > /tmp/openclaw-setup.exit
	: > /tmp/openclaw-setup.pid

	env_prefix=""
	if [ "$version" = "stable" ]; then
		tested_ver=$(grep '^OC_TESTED_VERSION=' /usr/bin/openclaw-env 2>/dev/null | cut -d'"' -f2)
		[ -n "$tested_ver" ] && env_prefix="OC_VERSION=$tested_ver "
	elif [ "$version" != "latest" ]; then
		# Validate version format
		echo "$version" | grep -qE '^[0-9a-zA-Z._-]+$' && env_prefix="OC_VERSION=$version "
	fi

	( eval ${env_prefix}/usr/bin/openclaw-env setup > /tmp/openclaw-setup.log 2>&1
	  RC=$?
	  echo $RC > /tmp/openclaw-setup.exit
	  if [ $RC -eq 0 ]; then
	    uci set openclaw.main.mode='source'
	    uci set openclaw.main.enabled=0
	    uci commit openclaw
	    echo "源码安装完成。已切换到 source 模式，但未自动启用或启动服务；请确认资源后手动启用。" >> /tmp/openclaw-setup.log
	  fi
	) &
	echo $! > /tmp/openclaw-setup.pid

	echo '{"status":"ok","message":"setup started"}'
	;;

# ═══════════════════════════════════════════
# SETUP_LOG — poll setup progress
# ═══════════════════════════════════════════
setup_log)
	job_state openclaw-setup
	;;

# ═══════════════════════════════════════════
# CHECK_UPDATE — check plugin version
# ═══════════════════════════════════════════
check_update)
	plugin_current=""
	[ -f "/usr/share/openclaw/VERSION" ] && plugin_current=$(cat /usr/share/openclaw/VERSION 2>/dev/null | tr -d '[:space:]')

	plugin_latest="" release_notes="" has_update=false
	repo=$(uci -q get openclaw.main.update_repo)
	[ -n "$repo" ] || repo="kenzok8/luci-app-openclaw"

	gh_json=$(curl -sf --connect-timeout 5 --max-time 10 \
		"https://api.github.com/repos/${repo}/releases/latest" 2>/dev/null)
	# jsonfilter 是 libubox 自带的，不必等 Node.js 装好就能查版本
	if [ -n "$gh_json" ]; then
		plugin_latest=$(printf '%s' "$gh_json" | jsonfilter -e '@.tag_name' 2>/dev/null | sed 's/^v//')
		release_notes=$(printf '%s' "$gh_json" | jsonfilter -e '@.body' 2>/dev/null)
	fi

	# 只有线上版本确实更新才算有更新：本地跑在发布版前面时不该提示升级
	if [ -n "$plugin_current" ] && [ -n "$plugin_latest" ] && [ "$(oc_version_gt "$plugin_latest" "$plugin_current")" = "1" ]; then
		has_update=true
	fi

	cat <<JSON
{
	"status": "ok",
	"repo": "$(json_esc "$repo")",
	"plugin_current": "$(json_esc "$plugin_current")",
	"plugin_latest": "$(json_esc "$plugin_latest")",
	"plugin_has_update": $has_update,
	"release_notes": "$(json_esc "$release_notes")"
}
JSON
	;;

# ═══════════════════════════════════════════
# GET_TOKEN — return gateway and PTY tokens
# ═══════════════════════════════════════════
get_token)
	token=$(uci -q get openclaw.main.token || echo "")
	pty_token=$(uci -q get openclaw.main.pty_token || echo "")
	printf '{"token":"%s","pty_token":"%s"}\n' "$token" "$pty_token"
	;;

# ═══════════════════════════════════════════
# UNINSTALL — remove environment
# ═══════════════════════════════════════════
uninstall)
	/etc/init.d/openclaw stop >/dev/null 2>&1
	/etc/init.d/openclaw disable 2>/dev/null
	uci set openclaw.main.enabled=0
	uci commit openclaw 2>/dev/null
	[ -d /opt/openclaw ] && { find /opt/openclaw -delete 2>/dev/null || true; }
	[ -d /root/.openclaw ] && { find /root/.openclaw -delete 2>/dev/null || true; }
	: > /tmp/openclaw-setup.log 2>/dev/null
	: > /tmp/openclaw-setup.pid 2>/dev/null
	: > /tmp/openclaw-setup.exit 2>/dev/null
	: > /tmp/openclaw-plugin-upgrade.log 2>/dev/null
	sed -i '/^openclaw:/d' /etc/passwd /etc/shadow /etc/group 2>/dev/null
	echo '{"status":"ok","message":"uninstalled"}'
	;;

# ═══════════════════════════════════════════
# PLUGIN_UPGRADE — upgrade plugin via .run
# ═══════════════════════════════════════════
plugin_upgrade)
	version="$2"
	[ -z "$version" ] && { echo '{"status":"error","message":"missing version"}'; exit 1; }
	echo "$version" | grep -qE '^[0-9.]+$' || { echo '{"status":"error","message":"invalid version"}'; exit 1; }
	repo=$(uci -q get openclaw.main.update_repo)
	[ -n "$repo" ] || repo="kenzok8/luci-app-openclaw"

	: > /tmp/openclaw-plugin-upgrade.log
	: > /tmp/openclaw-plugin-upgrade.exit
	: > /tmp/openclaw-plugin-upgrade.pid

	# apk 和 opkg 的包名规则不同，各取对应资产
	if command -v apk >/dev/null 2>&1; then
		pkg_file="/tmp/luci-app-openclaw-${version}.apk"
		pkg_url="https://github.com/${repo}/releases/download/v${version}/luci-app-openclaw-${version}.apk"
	else
		pkg_file="/tmp/luci-app-openclaw_${version}.ipk"
		pkg_url="https://github.com/${repo}/releases/download/v${version}/luci-app-openclaw_${version}_all.ipk"
	fi

	( echo "下载 $(basename "$pkg_url")..." > /tmp/openclaw-plugin-upgrade.log
	  if ! curl -fsSL --connect-timeout 15 --max-time 180 -o "$pkg_file" "$pkg_url" >> /tmp/openclaw-plugin-upgrade.log 2>&1; then
	    echo "下载失败" >> /tmp/openclaw-plugin-upgrade.log
	    rm -f "$pkg_file"
	    echo 1 > /tmp/openclaw-plugin-upgrade.exit
	  elif [ ! -s "$pkg_file" ]; then
	    echo "下载的文件为空，已中止" >> /tmp/openclaw-plugin-upgrade.log
	    rm -f "$pkg_file"
	    echo 1 > /tmp/openclaw-plugin-upgrade.exit
	  else
	    echo "下载完成，开始安装..." >> /tmp/openclaw-plugin-upgrade.log
	    if command -v apk >/dev/null 2>&1; then
	      apk add --allow-untrusted -U "$pkg_file" >> /tmp/openclaw-plugin-upgrade.log 2>&1
	    else
	      opkg install "$pkg_file" >> /tmp/openclaw-plugin-upgrade.log 2>&1
	    fi
	    RC=$?
	    rm -f "$pkg_file"
	    echo $RC > /tmp/openclaw-plugin-upgrade.exit
	    [ $RC -eq 0 ] && echo "插件升级完成" >> /tmp/openclaw-plugin-upgrade.log
	  fi
	) &
	echo $! > /tmp/openclaw-plugin-upgrade.pid
	echo '{"status":"ok","message":"upgrade started"}'
	;;

# ═══════════════════════════════════════════
# PLUGIN_UPGRADE_LOG — poll upgrade progress
# ═══════════════════════════════════════════
plugin_upgrade_log)
	job_state openclaw-plugin-upgrade
	;;

*)
	echo '{"status":"error","message":"unknown command"}'
	;;
esac
