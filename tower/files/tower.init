#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT

USE_PROCD=1
START=90
STOP=10

PROG=/usr/bin/tower

start_service() {
	config_load tower
	local data_dir listen
	config_get data_dir main data_dir "/etc/tower"
	config_get listen main listen "127.0.0.1:7443"

	procd_open_instance tower
	procd_set_param command "$PROG" -data "$data_dir" -listen "$listen"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
