msgstr "已取消上传。"

msgid "Upload file"
msgstr "上传文件"

msgid "Configuration applied."
msgstr "配置已应用。"

msgid "Changes saved. Apply them to reload Lucky."
msgstr "修改已保存，应用后将重新加载 Lucky。"

msgid "Save & Apply"
msgstr "保存并应用"

msgid "Reset"
msgstr "复位"

msgid "Unable to load the Lucky page. Reload to retry."
msgstr "无法加载 Lucky 页面，请刷新重试。"

msgid "Admin access policy"
msgstr "管理后台访问策略"

msgid "Admin access policy saved."
msgstr "管理后台访问策略已保存。"

msgid "Admin credentials reset"
msgstr "管理凭据已重置"

msgid "Admin HTTP port"
msgstr "管理后台 HTTP 端口"

msgid "Admin panel"
msgstr "管理后台"

msgid "Admin port saved."
msgstr "管理端口已保存。"

msgid "Admin safe URL"
msgstr "管理后台安全入口"

msgid "Admin safe URL saved."
msgstr "安全入口已保存。"

msgid "Configuration saved, but Lucky could not restart. Start it manually."
msgstr "配置已保存，但 Lucky 未能重新启动，请手动启动。"

msgid "Allow Internet access to the admin panel"
msgstr "允许从互联网访问管理后台"

msgid "Allowed"
msgstr "允许"

msgid "Account:"
msgstr "账号："

msgid "Are you sure you want to perform this service action?"
msgstr "确定要执行此服务操作吗？"

msgid "Available when the service is running"
msgstr "服务运行后可访问"

msgid "Build date"
msgstr "构建日期"

msgid "Close"
msgstr "关闭"

