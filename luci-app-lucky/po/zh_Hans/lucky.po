msgid "Session expired. Reload this page and sign in again."
msgstr "登录已过期，请刷新页面并重新登录。"

msgid "Choose file"
msgstr "选择文件"

msgid "Choose a non-empty file no larger than 64 MiB."
msgstr "请选择非空文件，大小不能超过 64 MiB。"

